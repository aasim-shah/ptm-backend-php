# Copy to .env on the server and fill in real values. Never commit .env.

APP_NAME="Parent Teacher Mobile"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://schoolsnow.parentteachermobile.com
APP_SITE=https://parentteachermobile.com
APP_DASHBOARD=
TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail (SendGrid over SMTP). MAIL_PASSWORD is the SendGrid API key.
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Optional separate SendGrid key for OTP / pincode emails (falls back to MAIL_PASSWORD).
SENDGRID_API_KEY=
OTP_ENABLED=true

# Pusher (Laravel Echo)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Agora video calls
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Secret configured for Agora Notification Center (NCS). Webhooks are rejected without it.
AGORA_WEBHOOK_SECRET=

# Firebase (push + chat). Place the service-account JSON at the path below on the server.
FIREBASE_CREDENTIALS=/absolute/path/to/storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_DB_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_APP_ID_WEB=
FIREBASE_MEASUREMENT_ID=
FCM_SERVER_KEY=
FCM_SENDER_ID=
PUSH_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# PayPal subscriptions. SANDBOX=true uses the sandbox credentials.
SANDBOX=false
PAYPAL_LIVE_ID=
PAYPAL_LIVE_SECRET=
PAYPAL_SANDBOX_ID=
PAYPAL_SANDBOX_SECRET=
# Webhook ID from the PayPal dashboard. PayPal webhooks are rejected without it.
PAYPAL_WEBHOOK_ID=

# Subscription limits (example values; set to your real plan). TRAIL / PREMIUM are call minutes.
TRAIL=60
TRAIL_DAYS=5
TRAIL_CALL_COUNT=5
PREMIUM=600
PREMIUM_PRICE=9.99
PREMIUM_CALL_COUNT=100

# Fee payment gateways
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin
DEMO_MODE=false
# Allow the admin "System update" zip upload (overwrites code). Keep false in production.
SYSTEM_UPDATE_ENABLED=false
# Used only by AddSuperAdminSeeder when no admin exists yet.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
